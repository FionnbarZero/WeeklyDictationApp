# Copy to .env.staging.local. That file is ignored by Git.
# Firebase web configuration is public client configuration, but the staging
# project identity must remain explicit so a staging build cannot target a
# production project by accident.
VITE_DEPLOYMENT_ENV=staging
VITE_STAGING_SYNTHETIC_ONLY=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Register the staging web app with reCAPTCHA Enterprise in Firebase App Check.
# Begin with App Check enforcement disabled so metrics can be reviewed, then
# enable enforcement only after legitimate staging traffic is verified.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional Firebase Performance collection. B1 staging builds require this to
# remain enabled so page and network trends are available during rehearsal.
VITE_STAGING_OBSERVABILITY=true
