# Firebase Web API configuration. These values are safe client configuration, not private keys.
# Create a Firebase project, enable Email/Password Authentication and Firestore, then copy the web app values here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=

# Optional future backend/importer configuration (do not put service-account secrets in this file).
VITE_WEEKLY_DECK_ID=10gpdTFqwBhWf9pD9HzF8AkD9Zyg7nBUSeTCGXuS8ky4
VITE_WEEKLY_DECK_TIME_ZONE=America/Los_Angeles

# Trusted local importer only. Export these in the shell when explicitly writing validated Grade 2 data.
# FIREBASE_PROJECT_ID=
# FIRESTORE_ACCESS_TOKEN=
# IMPORT_RUN_TOKEN=  # backend-only HTTP authorization; never expose as VITE_*

# Trusted Node-only read-only Slides hydration. Export real values in the shell;
# never save OAuth credentials in this file, .env.local, or browser VITE_* values.
# GOOGLE_SLIDES_PRESENTATION_ID=10gpdTFqwBhWf9pD9HzF8AkD9Zyg7nBUSeTCGXuS8ky4
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
